<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pcserve.exe"
        Arguments=""
        InstallLocation="C:\Program Files\pcserve\桌面宠物">
    </Installer>
    <PackageInformation
        PackageName="桌面宠物"
        PackageDisplayName="桌面宠物"
        PublisherName="CN=pcserve"
        PublisherDisplayName="pcserve"
        Version="0.1.0.0"
        PackageDescription="Desktop 3D pet">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.pcserve.pet"
                Description="Desktop 3D pet"
                DisplayName="桌面宠物"
                ExecutableName="pcserve.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>桌面宠物</DisplayName>
            <PublisherDisplayName>pcserve</PublisherDisplayName>
            <Description>Desktop 3D pet</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pcserve.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
